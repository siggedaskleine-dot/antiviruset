<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Lets the project build on Linux and macOS too; the program itself only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MattesAntivirus</AssemblyName>
    <RootNamespace>MattesAntivirus.App</RootNamespace>
    <ApplicationIcon>Assets\MattesAntivirus.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Mattes Antivirus</Product>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MattesAntivirus.Core\MattesAntivirus.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\MattesAntivirus.ico" />
    <Resource Include="Assets\Logo.png" />
  </ItemGroup>

</Project>
